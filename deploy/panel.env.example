# Operator configuration: literal KEY=value, no quotes or shell interpolation.
# Store outside the downloaded bundle, owned by deploy user, mode 0600.
# Installer sets the image from release.json; no PANEL_IMAGE here.
PANEL_HOST_PORT=18080
PANEL_PUBLIC_ORIGIN=https://panel.example.invalid
PANEL_YOUTRACK_URL=https://youtrack.example.invalid
PANEL_PROJECT_ID=0-1
PANEL_PROJECT_KEY=HL
PANEL_OWNER_LOGIN=owner.example
PANEL_CURSOR_MODEL=composer-2.5
# Required for installation; provision a Panel-only key, never a bot secret.
PANEL_CURSOR_API_KEY=

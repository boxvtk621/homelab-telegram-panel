{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://h1-cloud.local/schemas/agent-configuration-v2.schema.json","title":"R09 inert agent configuration",
  "$defs":{
    "uuid":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "credentialRef":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"},
    "managed":{"type":"object","additionalProperties":false,"required":["kind","hostId","dockerfileRevision"],"properties":{"kind":{"const":"managed"},"hostId":{"$ref":"#/$defs/uuid"},"dockerfileRevision":{"$ref":"#/$defs/uuid"},"buildContextRevision":{"$ref":"#/$defs/uuid"},"registryCredentialRef":{"$ref":"#/$defs/credentialRef"}}},
    "external":{"type":"object","additionalProperties":false,"required":["kind","endpointRef"],"properties":{"kind":{"const":"external"},"endpointRef":{"$ref":"#/$defs/credentialRef"}}},
    "tool":{"type":"object","additionalProperties":false,"required":["name","schemaHash"],"properties":{"name":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"schemaHash":{"type":"string","pattern":"^(?:sha256:)?[0-9a-f]{64}$"}}},
    "mcp":{"type":"object","additionalProperties":false,"required":["serverId","transport","uri","tools"],"properties":{"serverId":{"type":"string","minLength":1,"maxLength":128},"transport":{"enum":["stdio","streamable-http"]},"uri":{"type":"string","minLength":1,"maxLength":2048},"credentialRef":{"$ref":"#/$defs/credentialRef"},"tools":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/tool"}}}},
    "profile":{"type":"object","additionalProperties":false,"required":["mode","basePrompt","instructions","mcp","access"],"properties":{"mode":{"enum":["universal","specialized"]},"basePrompt":{"type":"string","maxLength":65536},"instructions":{"type":"array","maxItems":128,"items":{"type":"string","minLength":1,"maxLength":16384}},"mcp":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/mcp"}},"access":{"type":"object","additionalProperties":false,"required":["default","nativeTools"],"properties":{"default":{"const":"deny"},"nativeTools":{"type":"array","maxItems":128,"items":{"type":"string","minLength":1,"maxLength":128}}}}}},
    "configuration":{"type":"object","additionalProperties":false,"required":["schemaVersion","name","engine","deployment","profile"],"properties":{"schemaVersion":{"const":2},"name":{"type":"string","minLength":1,"maxLength":120},"engine":{"enum":["cursor","codex"]},"deployment":{"oneOf":[{"$ref":"#/$defs/managed"},{"$ref":"#/$defs/external"}]},"profile":{"$ref":"#/$defs/profile"}}},
    "asset":{"type":"object","additionalProperties":false,"required":["path","assetId","sha256"],"properties":{"path":{"type":"string","minLength":1,"maxLength":256,"pattern":"^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},"assetId":{"$ref":"#/$defs/uuid"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "buildContextManifest":{"type":"object","additionalProperties":false,"required":["revision","assets"],"properties":{"revision":{"$ref":"#/$defs/uuid"},"assets":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/asset"}}}}
  },
  "$ref":"#/$defs/configuration"
}

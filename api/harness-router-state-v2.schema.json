{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h1-cloud.local/schemas/harness-router-state-v2.schema.json",
  "title": "Durable Harness Router projection state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ownerId", "registryVersion", "registrySHA256", "registryOperationId", "registryRequestSHA256", "registryEnvelope", "nodes"],
  "properties": {
    "schema": { "const": 2 },
    "ownerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "registryVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "registrySHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "registryOperationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "registryRequestSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "registryEnvelope": { "$ref": "https://h1-cloud.local/schemas/harness-router-registry-v1.schema.json" },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "stateVersion", "generation", "registrationRevision", "identityEpoch", "compatibility", "adapterKind", "adapterVersion"],
          "properties": {
            "mode": { "enum": ["eligible", "draining", "sealed"] },
            "stateVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "operationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
            "registrationRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "identityEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "compatibility": { "enum": ["compatible", "legacy_readonly"] },
            "adapterKind": { "enum": ["cursor", "codex"] },
            "adapterVersion": { "type": "string", "pattern": "^$|^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "sealScope": {
              "oneOf": [
                { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "node" } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "dialogId"], "properties": { "kind": { "const": "dialog" }, "dialogId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } } }
              ]
            },
            "sealHoldVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "sealScopeRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "sealedProofHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h1-cloud.local/schemas/harness-tunnel-bindings-v1.schema.json",
  "title": "Harness private tunnel endpoint bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "ownerId", "registrySHA256", "nodes"],
  "properties": {
    "schemaId": { "const": "harness-tunnel-bindings-v1" },
    "ownerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "registrySHA256": { "$ref": "#/$defs/sha256" },
    "acceptedRegistrySHA256s": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/endpoint" }
    }
  },
  "$defs": {
    "safeInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "uuid": { "type": "string", "format": "uuid" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId", "registrationRevision", "registrationEpoch", "endpointRevision",
        "hostId", "hostVersion", "transport", "targetRef", "credentialRef",
        "dockerContextRef", "expectedHostKey", "expectedHostIdentitySHA256",
        "hostPlatform", "hostArchitecture", "containerId", "runtimeGeneration", "address"
      ],
      "properties": {
        "kind": { "const": "external" },
        "nodeId": { "$ref": "#/$defs/uuid" },
        "registrationRevision": { "$ref": "#/$defs/safeInteger" },
        "registrationEpoch": { "$ref": "#/$defs/safeInteger" },
        "endpointRevision": { "$ref": "#/$defs/safeInteger" },
        "hostId": { "$ref": "#/$defs/uuid" },
        "hostVersion": { "$ref": "#/$defs/safeInteger" },
        "transport": { "enum": ["local", "ssh"] },
        "targetRef": { "$ref": "#/$defs/ref" },
        "credentialRef": { "type": "string", "maxLength": 128 },
        "dockerContextRef": { "type": "string", "maxLength": 128 },
        "expectedHostKey": { "type": "string", "maxLength": 80 },
        "expectedHostIdentitySHA256": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" },
        "hostPlatform": { "enum": ["", "linux", "darwin", "windows"] },
        "hostArchitecture": { "enum": ["", "amd64", "arm64"] },
        "containerId": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" },
        "runtimeGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "address": { "type": "string", "minLength": 3, "maxLength": 64 }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "external" } } },
          "then": {
            "properties": {
              "dockerContextRef": { "const": "" },
              "expectedHostIdentitySHA256": { "const": "" },
              "hostPlatform": { "const": "" },
              "hostArchitecture": { "const": "" },
              "containerId": { "const": "" },
              "runtimeGeneration": { "const": 0 }
            }
          },
          "else": {
            "properties": {
              "dockerContextRef": { "$ref": "#/$defs/ref" },
              "expectedHostIdentitySHA256": { "$ref": "#/$defs/sha256" },
              "hostPlatform": { "enum": ["linux", "darwin", "windows"] },
              "hostArchitecture": { "enum": ["amd64", "arm64"] },
              "containerId": { "$ref": "#/$defs/sha256" },
              "runtimeGeneration": { "$ref": "#/$defs/safeInteger" }
            }
          }
        },
        {
          "if": { "properties": { "transport": { "const": "local" } } },
          "then": {
            "properties": {
              "credentialRef": { "const": "" },
              "expectedHostKey": { "const": "" }
            }
          }
        },
        {
          "if": { "properties": { "transport": { "const": "ssh" } } },
          "then": {
            "properties": {
              "credentialRef": { "$ref": "#/$defs/ref" },
              "expectedHostKey": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{20,64}$" },
              "address": { "type": "string", "pattern": "^127\\.0\\.0\\.1:[1-9][0-9]{0,4}$" }
            }
          }
        }
      ]
    }
  }
}

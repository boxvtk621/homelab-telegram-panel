{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h1-cloud.local/schemas/harness-router-registry-v1.schema.json",
  "title": "Signed Harness Router registry projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "signature"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "registryVersion", "ownerId", "mode", "wireSchemaSHA256", "nodes"],
      "properties": {
        "schemaId": { "const": "harness-router-registry-v1" },
        "registryVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "ownerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
        "mode": { "enum": ["live", "fixture"] },
        "wireSchemaSHA256": { "const": "5bd97f2ea08854a8e56d46ff11a1539e6bc54e8ca6d42841b366561accba73d9" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "name", "adapter", "url", "certificateSHA256", "registrationRevision", "registrationEpoch", "compatibility"],
            "properties": {
              "nodeId": { "type": "string", "format": "uuid" },
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "adapter": { "enum": ["cursor", "codex"] },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "certificateSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "registrationRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "registrationEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "compatibility": { "enum": ["compatible", "legacy_readonly"] },
              "endpointBindingSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "signature": { "type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{86}==$" }
  }
}

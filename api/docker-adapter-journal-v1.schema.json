{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h1-cloud.local/schemas/docker-adapter-journal-v1.schema.json",
  "title": "Docker adapter durable operation journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "daemonId", "instanceId", "entries"],
  "properties": {
    "schemaId": { "const": "docker-adapter-journal-v1" },
    "daemonId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "instanceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "stepId", "generation", "requestHash", "resourceIds", "state", "updatedAt"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
          "stepId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
          "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "requestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "resourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" }
          },
          "state": { "enum": ["sent", "acknowledged", "reconciled", "failed"] },
          "outcome": { "enum": ["applied", "not_applied", "failed"] },
          "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "sent" } }, "required": ["state"] },
            "then": { "properties": { "outcome": false, "receiptId": false } },
            "else": {
              "properties": {
                "outcome": { "enum": ["applied", "not_applied", "failed"] },
                "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" }
              },
              "required": ["outcome", "receiptId"]
            }
          }
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h1-cloud.local/schemas/agent-host-v1.schema.json",
  "title": "R07 Docker host descriptor and read-only observation",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "optionalRef": { "type": "string", "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._:@-]{0,127})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "optionalSHA256": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" },
    "platform": { "type": "string", "enum": ["linux", "darwin", "windows"] },
    "architecture": { "type": "string", "enum": ["amd64", "arm64"] },
    "hostFields": {
      "type": "object",
      "required": ["hostId", "displayName", "transport", "targetRef", "credentialRef", "registryCredentialRef", "expectedHostKey", "dockerContextRef", "expectedIdentitySHA256", "hostPlatform", "hostArchitecture"],
      "properties": {
        "hostId": { "$ref": "#/$defs/uuid" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "transport": { "type": "string", "enum": ["local", "ssh"] },
        "targetRef": { "$ref": "#/$defs/ref" },
        "credentialRef": { "$ref": "#/$defs/optionalRef" },
        "registryCredentialRef": { "$ref": "#/$defs/optionalRef" },
        "expectedHostKey": { "type": "string", "pattern": "^(?:|SHA256:[A-Za-z0-9+/]{20,64})$" },
        "dockerContextRef": { "$ref": "#/$defs/ref" },
        "expectedIdentitySHA256": { "$ref": "#/$defs/optionalSHA256" },
        "hostPlatform": { "$ref": "#/$defs/platform" },
        "hostArchitecture": { "$ref": "#/$defs/architecture" }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "local" } } },
          "then": { "properties": { "credentialRef": { "const": "" }, "expectedHostKey": { "const": "" } } },
          "else": { "properties": { "credentialRef": { "$ref": "#/$defs/ref" } } }
        }
      ]
    },
    "HostUpsert": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/hostFields" },
        {
          "type": "object",
          "required": ["schemaId", "expectedHostVersion"],
          "properties": {
            "schemaId": { "const": "agent-host-upsert-v1" },
            "expectedHostVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "HostDescriptor": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/hostFields" },
        {
          "type": "object",
          "required": ["schemaId", "hostVersion"],
          "properties": {
            "schemaId": { "const": "docker-host-descriptor-v1" },
            "hostVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "HostSecretInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "operationId", "kind", "privateKey", "passphrase", "payload"],
      "properties": {
        "schemaId": { "const": "docker-secret-input-v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "kind": { "type": "string", "enum": ["ssh", "registry"] },
        "privateKey": { "type": "string", "contentEncoding": "base64", "maxLength": 87384 },
        "passphrase": { "type": "string", "contentEncoding": "base64", "maxLength": 5464 },
        "payload": { "type": "string", "contentEncoding": "base64", "maxLength": 87384 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "ssh" } } },
          "then": { "properties": { "privateKey": { "type": "string", "minLength": 1 }, "payload": { "const": "" } } },
          "else": { "properties": { "privateKey": { "const": "" }, "passphrase": { "const": "" }, "payload": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "HostSecretProvision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "operationId", "kind", "status", "credentialRef"],
      "properties": {
        "schemaId": { "const": "docker-secret-provision-v1" },
        "operationId": { "$ref": "#/$defs/uuid" },
        "kind": { "type": "string", "enum": ["ssh", "registry"] },
        "status": { "const": "provisioned" },
        "credentialRef": { "$ref": "#/$defs/ref" }
      }
    },
    "HostProbeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "expectedHostVersion"],
      "properties": {
        "schemaId": { "const": "agent-host-probe-v1" },
        "expectedHostVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "HostObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "hostId", "hostVersion", "observedAt", "availability", "failureStage", "failureCode", "nextAction", "hostKeySHA256", "daemonId", "dockerContextRef", "contextEndpoint", "engineOS", "architecture", "apiVersion", "engineVersion", "capabilities", "identitySHA256", "registryAvailability"],
      "properties": {
        "schemaId": { "const": "docker-host-observation-v1" },
        "hostId": { "$ref": "#/$defs/uuid" },
        "hostVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "observedAt": { "type": "string", "format": "date-time" },
        "availability": { "type": "string", "enum": ["ready", "unavailable"] },
        "failureStage": { "$ref": "#/$defs/optionalRef" },
        "failureCode": { "$ref": "#/$defs/optionalRef" },
        "nextAction": { "type": "string", "maxLength": 300 },
        "hostKeySHA256": { "type": "string", "maxLength": 80, "pattern": "^(?:|SHA256:[A-Za-z0-9+/]{20,64})$" },
        "daemonId": { "type": "string", "maxLength": 128 },
        "dockerContextRef": { "$ref": "#/$defs/ref" },
        "contextEndpoint": { "type": "string", "maxLength": 80 },
        "engineOS": { "type": "string", "maxLength": 160 },
        "architecture": { "type": "string", "maxLength": 160 },
        "apiVersion": { "type": "string", "maxLength": 32 },
        "engineVersion": { "type": "string", "maxLength": 64 },
        "capabilities": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "identitySHA256": { "$ref": "#/$defs/optionalSHA256" },
        "registryAvailability": { "type": "string", "enum": ["not_configured", "not_checked", "ready", "unavailable"] }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "ready" } } },
          "then": {
            "properties": {
              "failureStage": { "const": "" }, "failureCode": { "const": "" }, "nextAction": { "const": "" },
              "daemonId": { "type": "string", "minLength": 1 }, "contextEndpoint": { "type": "string", "minLength": 1 }, "engineOS": { "const": "linux" },
              "architecture": { "$ref": "#/$defs/architecture" }, "apiVersion": { "type": "string", "minLength": 1 },
              "engineVersion": { "type": "string", "minLength": 1 }, "identitySHA256": { "$ref": "#/$defs/sha256" }
            }
          },
          "else": {
            "properties": {
              "failureStage": { "$ref": "#/$defs/ref" }, "failureCode": { "$ref": "#/$defs/ref" },
              "nextAction": { "type": "string", "minLength": 1 }, "identitySHA256": { "const": "" }
            }
          }
        }
      ]
    },
    "HostRecord": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/hostFields" },
        {
          "type": "object",
          "required": ["schemaId", "hostVersion", "observedAt", "availability", "failureStage", "failureCode", "nextAction", "hostKeySHA256", "daemonId", "contextEndpoint", "engineOS", "architecture", "apiVersion", "engineVersion", "capabilities", "identitySHA256", "registryAvailability"],
          "properties": {
            "schemaId": { "const": "agent-host-v1" },
            "hostVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "observedAt": { "type": ["string", "null"], "format": "date-time" },
            "availability": { "type": "string", "enum": ["unverified", "ready", "unavailable"] },
            "failureStage": { "$ref": "#/$defs/optionalRef" },
            "failureCode": { "$ref": "#/$defs/optionalRef" },
            "nextAction": { "type": "string", "maxLength": 300 },
            "hostKeySHA256": { "type": "string", "maxLength": 80 },
            "daemonId": { "type": "string", "maxLength": 128 },
            "contextEndpoint": { "type": "string", "maxLength": 80 },
            "engineOS": { "type": "string", "maxLength": 160 },
            "architecture": { "type": "string", "maxLength": 160 },
            "apiVersion": { "type": "string", "maxLength": 32 },
            "engineVersion": { "type": "string", "maxLength": 64 },
            "capabilities": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
            "identitySHA256": { "$ref": "#/$defs/optionalSHA256" },
            "registryAvailability": { "type": "string", "enum": ["not_configured", "not_checked", "ready", "unavailable"] }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "availability": { "const": "unverified" }, "observedAt": { "const": null },
                "failureStage": { "const": "" }, "failureCode": { "const": "" }, "nextAction": { "const": "" },
                "identitySHA256": { "const": "" }
              }
            },
            {
              "properties": {
                "availability": { "const": "ready" }, "observedAt": { "type": "string", "format": "date-time" },
                "failureStage": { "const": "" }, "failureCode": { "const": "" }, "nextAction": { "const": "" },
                "daemonId": { "type": "string", "minLength": 1 }, "contextEndpoint": { "type": "string", "minLength": 1 },
                "engineOS": { "const": "linux" }, "architecture": { "$ref": "#/$defs/architecture" },
                "apiVersion": { "type": "string", "minLength": 1 }, "engineVersion": { "type": "string", "minLength": 1 },
                "identitySHA256": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "properties": {
                "availability": { "const": "unavailable" }, "observedAt": { "type": "string", "format": "date-time" },
                "failureStage": { "$ref": "#/$defs/ref" }, "failureCode": { "$ref": "#/$defs/ref" },
                "nextAction": { "type": "string", "minLength": 1 }, "identitySHA256": { "const": "" }
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "HostPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "items", "nextCursor"],
      "properties": {
        "schemaId": { "const": "agent-host-page-v1" },
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/HostRecord" } },
        "nextCursor": { "type": ["string", "null"], "maxLength": 512 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/HostUpsert" },
    { "$ref": "#/$defs/HostDescriptor" },
    { "$ref": "#/$defs/HostSecretInput" },
    { "$ref": "#/$defs/HostSecretProvision" },
    { "$ref": "#/$defs/HostProbeRequest" },
    { "$ref": "#/$defs/HostObservation" },
    { "$ref": "#/$defs/HostRecord" },
    { "$ref": "#/$defs/HostPage" }
  ]
}

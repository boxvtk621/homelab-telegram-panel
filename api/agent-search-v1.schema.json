{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-search-v1",
  "oneOf": [
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/metadata" },
    { "$ref": "#/$defs/entryLookup" }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "query": {
      "type": "object", "additionalProperties": false, "required": ["q"],
      "properties": {
        "q": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "nodeId": { "$ref": "#/$defs/uuid" },
        "logicalDialogId": { "$ref": "#/$defs/uuid" },
        "archived": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["logicalDialogId", "entryId", "nodeId", "nodeDialogId", "title", "role", "kind", "createdAt", "rank", "snippet"],
      "properties": {
        "logicalDialogId": { "$ref": "#/$defs/uuid" }, "entryId": { "$ref": "#/$defs/uuid" },
        "nodeId": { "$ref": "#/$defs/uuid" }, "nodeDialogId": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "maxLength": 1000 }, "role": { "enum": ["user", "assistant"] },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }, "rank": { "type": "number" },
        "snippet": { "type": "string", "maxLength": 512 }
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId", "query", "items", "nextCursor", "totalCount", "observedAt", "lagMillis", "incomplete"],
      "properties": {
        "schemaId": { "const": "agent-search-v1" }, "query": { "$ref": "#/$defs/query" },
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/item" } },
        "nextCursor": { "type": ["string", "null"], "minLength": 1, "maxLength": 8192 }, "totalCount": { "$ref": "#/$defs/safeInteger" },
        "observedAt": { "type": "string", "format": "date-time" }, "lagMillis": { "$ref": "#/$defs/safeInteger" },
        "incomplete": { "type": "boolean" }
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId", "nodeId", "nodeDialogId", "bindingGeneration", "title", "archived", "updatedAt"],
      "properties": {
        "schemaId": { "const": "agent-search-dialog-metadata-v1" }, "logicalDialogId": { "$ref": "#/$defs/uuid" },
        "nodeId": { "$ref": "#/$defs/uuid" }, "nodeDialogId": { "$ref": "#/$defs/uuid" },
        "bindingGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "title": { "type": "string", "maxLength": 1000 }, "archived": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "nodeDialogId", "authorEventId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/uuid" }, "nodeDialogId": { "$ref": "#/$defs/uuid" },
        "authorEventId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "userInlineContent": {
      "type": "object", "additionalProperties": false, "required": ["kind", "content"],
      "properties": { "kind": { "const": "inline" }, "content": { "type": "string", "maxLength": 65536 } }
    },
    "assistantInlineContent": {
      "type": "object", "additionalProperties": false, "required": ["kind", "content", "redaction", "truncated"],
      "properties": {
        "kind": { "const": "inline" }, "content": { "type": "string", "maxLength": 65536 },
        "redaction": { "enum": ["none", "applied"] }, "truncated": { "type": "boolean" }
      }
    },
    "artifactContent": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifactId", "sizeBytes", "sha256", "redaction", "truncated"],
      "properties": {
        "kind": { "const": "artifact" }, "artifactId": { "$ref": "#/$defs/uuid" },
        "sizeBytes": { "$ref": "#/$defs/safeInteger" }, "sha256": { "$ref": "#/$defs/sha256" },
        "redaction": { "enum": ["none", "applied"] }, "truncated": { "type": "boolean" }
      }
    },
    "unavailableContent": {
      "type": "object", "additionalProperties": false, "required": ["kind", "reason", "redaction", "truncated"],
      "properties": {
        "kind": { "const": "unavailable" },
        "reason": { "enum": ["not_observed", "provider_redacted", "output_limit", "unmapped"] },
        "redaction": { "enum": ["none", "applied", "unknown"] }, "truncated": { "type": "boolean" }
      }
    },
    "transcriptEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["entryId", "origin", "logicalDialogId", "messageId", "kind", "role", "content", "createdAt", "sourceGeneration", "executionOrdinal", "executionStatus"],
      "properties": {
        "entryId": { "$ref": "#/$defs/uuid" }, "origin": { "$ref": "#/$defs/origin" },
        "logicalDialogId": { "$ref": "#/$defs/uuid" }, "messageId": { "$ref": "#/$defs/uuid" },
        "requestId": { "$ref": "#/$defs/uuid" }, "attemptId": { "$ref": "#/$defs/uuid" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 }, "role": { "enum": ["user", "assistant"] },
        "content": true, "createdAt": { "type": "string", "format": "date-time" },
        "profileHash": { "$ref": "#/$defs/sha256" }, "sourceGeneration": { "$ref": "#/$defs/safeInteger" },
        "executionOrdinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "executionStatus": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "user" } }, "required": ["role"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/userInlineContent" } } },
          "else": { "properties": { "content": { "oneOf": [
            { "$ref": "#/$defs/assistantInlineContent" }, { "$ref": "#/$defs/artifactContent" }, { "$ref": "#/$defs/unavailableContent" }
          ] } } }
        }
      ]
    },
    "entryLookup": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId", "entry", "observedAt", "lagMillis", "incomplete"],
      "properties": {
        "schemaId": { "const": "agent-history-entry-v1" }, "entry": { "$ref": "#/$defs/transcriptEntry" },
        "observedAt": { "type": "string", "format": "date-time" }, "lagMillis": { "$ref": "#/$defs/safeInteger" },
        "incomplete": { "type": "boolean" }
      }
    }
  }
}

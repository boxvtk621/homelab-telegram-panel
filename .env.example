# Synthetic placeholders. Do not put bot tokens, YouTrack tokens or keys here.
PANEL_IMAGE=homelab-telegram-panel:local
PANEL_HOST_PORT=18080
PANEL_PUBLIC_ORIGIN=https://panel.example.invalid
PANEL_YOUTRACK_URL=https://youtrack.example.invalid
PANEL_PROJECT_ID=0-1
PANEL_PROJECT_KEY=HL
PANEL_OWNER_LOGIN=owner.example

# Optional Harness trust and Router files, all seven required when configured. See
# docs/harness-panel.md. These are container-local paths to separately
# provisioned files; this template does not mount or create credentials.
# PANEL_HARNESS_REGISTRY=/run/harness/registry.json
# PANEL_HARNESS_SIGNER_PUBLIC_KEY=/run/harness/registry-signer-public.pem
# PANEL_HARNESS_CA=/run/harness/node-ca.pem
# PANEL_HARNESS_CLIENT_CERT=/run/harness/panel-client.pem
# PANEL_HARNESS_CLIENT_KEY=/run/harness/panel-client-key.pem
# PANEL_HARNESS_ROUTER_STATE=/router/state.json
# PANEL_HARNESS_ROUTER_SOCKET=/router/control.sock
